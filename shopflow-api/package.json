{
  "name": "shopflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "ShopFlow backend API (hexagonal architecture) consumed by shopflow-web and verified by shopflow-infra",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/main/server.js",
    "migrate": "node dist/main/migrate.js",
    "seed": "node dist/main/seed.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:architecture": "vitest run tests/architecture",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
